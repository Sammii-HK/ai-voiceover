{
  "name": "ai-voiceover-edge",
  "version": "1.0.0",
  "description": "AI Voiceover API on Cloudflare Workers Edge",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "db:create": "wrangler d1 create ai-voiceover-db",
    "db:migrate": "wrangler d1 execute ai-voiceover-db --file=./schema.sql",
    "db:migrate:staging": "wrangler d1 execute ai-voiceover-db --env staging --file=./schema.sql",
    "r2:create": "wrangler r2 bucket create ai-voiceover-temp",
    "tail": "wrangler tail",
    "types": "wrangler types"
  },
  "keywords": ["cloudflare", "workers", "edge", "ai", "tts", "hono"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.84.1"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.4",
    "openai": "^6.7.0"
  }
}